
# PennylessTrack - Git ignore

# Sistema operativo
.DS_Store
Thumbs.db
Desktop.ini

# Editores y entornos de desarrollo
.vscode/
.idea/
*.swp
*.swo
*~

# Archivos temporales
*.tmp
*.temp
*.log
*.bak
*.cache
tmp/
temp/
logs/

# Dependencias JavaScript / Node.js
node_modules/

# Archivos generados
dist/
build/
coverage/
__pycache__/
*.py[cod]

# Entornos virtuales Python
.venv/
venv/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Archivos locales de configuración
*.local
